{
  "name": "direct-apply",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:create": "wrangler d1 create direct-apply",
    "db:migrate": "wrangler d1 migrations apply direct-apply --remote",
    "db:migrate:local": "wrangler d1 migrations apply direct-apply --local",
    "db:seed": "node scripts/build-seed.mjs && wrangler d1 execute direct-apply --remote --file=seed/seed.generated.sql",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:seed:local": "node scripts/build-seed.mjs && wrangler d1 execute direct-apply --local --file=seed/seed.generated.sql",
    "dev:offline": "cross-env LOCAL_ONLY=1 next dev",
    "daily": "node scripts/daily.mjs",
    "setup:local": "npm run db:migrate:local && npm run db:seed:local"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "@opennextjs/cloudflare": "^1.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
